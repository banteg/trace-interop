+    final JsonNode result = nextWaveTrace(code, 1000000);
+    final JsonNode ops = result.get("vmTrace").get("ops");
+    int calls = 0;
+    for (int i = 0; i < ops.size(); i++) {
+      final JsonNode op = ops.get(i);
+      if (op.get("pc").asInt() == 37) {
+        calls++;
+        final long used = op.get("ex").get("used").asLong();
+        final long resume = ops.get(i + 1).get("ex").get("used").asLong() + 2;
+        assertThat(used).as("call %s resumption gas", calls).isEqualTo(resume);
+      }
+    }
+    assertThat(calls).isEqualTo(64);
+  }
