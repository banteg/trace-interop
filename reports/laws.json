  "laws": [
    {
      "id": "L01",
      "statement": "Every frame list is a preorder tree: one root, unique dense paths, subtraces equal to the number of children, and no frame using more gas than it was given.",
      "title": "Tree shape"
    },
    {
      "id": "L02",
      "statement": "A stateDiff `*` entry changes its value: `from` differs from `to`.",
      "title": "Changed values"
    },
    {
      "id": "L03",
      "statement": "A successful root call frame reports the envelope output.",
      "title": "Root output"
    },
    {
      "id": "L04",
      "statement": "Requests that differ only in their trace types return the same output and the same value for every component both select.",
      "title": "Selection is a projection"
    },
    {
      "id": "L05",
      "statement": "A record trace_get returns is one of the trace_transaction records, unchanged; under the trace profile it is the requested traceAddress, or null for an absent path.",
      "title": "trace_get selects from trace_transaction"
    },
    {
      "id": "L06",
      "statement": "trace_transaction(tx) equals the trace_block records carrying its hash, in order.",
      "title": "trace_transaction is a slice of trace_block"
    },
    {
      "id": "L07",
      "statement": "The frames of trace_transaction and trace_block equal the replayed trace of the same transaction, apart from localization fields.",
      "title": "Stored and replayed frames agree"
    },
    {
      "id": "L08",
      "statement": "trace_replayTransaction(tx) equals the block replay envelope of that transaction for every shared selected component; under the trace profile that envelope must exist at its transaction index and carry its hash.",
      "title": "Single and block replay agree"
    },
    {
      "id": "L09",
      "statement": "trace_callMany items equal the same items replayed as a shorter bundle, and a first item equals trace_call on the same block.",
      "title": "A bundle item is a call"
    },
    {
      "id": "L10",
      "statement": "trace_filter over an explicit range returns block records, unchanged and in block order; without addresses or paging it returns all of them.",
      "title": "Filters select block records"
    },
    {
      "id": "L11",
      "statement": "trace_filter with after and count returns that slice of the same filter without them.",
      "title": "Paging slices the filter"
    },
    {
      "id": "L12",
      "statement": "The same request, or one that differs only in address letter case or in naming one block by number, hash or head tag, returns the same result.",
      "title": "Equivalent block and address spellings"
    }
  ],
