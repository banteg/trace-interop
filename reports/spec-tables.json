      {
        "id": "root-precompile",
        "quote": "Retain root precompile calls regardless of value."
      },
      {
        "id": "nested-zero-precompile",
        "quote": "Omit nested precompile frames with zero value"
      },
      {
        "id": "nested-value-precompile",
        "quote": "retain nested frames with nonzero transferred or inherited value, whether successful or failed"
      },
      {
        "id": "call-precheck",
        "quote": "A CALL-family call that fails its precheck (call depth limit or insufficient balance) emits a frame with its action and error, no result and no subtraces"
      },
      {
        "id": "create-precheck",
        "quote": "A CREATE or CREATE2 that fails its precheck (call depth limit, insufficient balance or nonce overflow) emits the same kind of frame before Amsterdam"
      },
      {
        "id": "create-precheck-amsterdam",
        "quote": "from Amsterdam the check runs in the creating opcode and no frame is emitted"
      },
      {
        "id": "collision",
        "quote": "A CREATE whose address collides emits a create frame with error \"Contract address collision\" that consumes its gas."
      },
      {
        "id": "halt-result",
        "quote": "Exceptional halt, including an address collision; result is omitted or null."
      },
      {
        "id": "halt",
        "quote": "An exceptional halt consumes the frame's action gas; its result may be omitted or null."
      },
      {
        "id": "revert",
        "quote": "A REVERT frame has error \"Reverted\" and a required result {gasUsed, output} carrying its revert bytes"
      },
      {
        "id": "success",
        "quote": "Successful frame; result is required and error must be absent."
      },
      {
        "id": "error-alone",
        "quote": "error alone determines failure."
      }
